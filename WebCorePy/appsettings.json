{
  "AppSettings": {
    "AnacondaPath": "C:\\ProgramData\\Anaconda3",
    "PythonExePath": "C:\\ProgramData\\Anaconda3\\python.exe"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "File": {
      "Path": "WebCorePy.log",
      "Append": true,
      "MinLevel": "Information", // min level for the file logger
      "FileSizeLimitBytes": 1000000, // use to activate rolling file behaviour
      "MaxRollingFiles": 10 // use to specify max number of log files
    }
  },
  "AllowedHosts": "*",
  "NumWorkers": 5
}
