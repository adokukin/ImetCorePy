@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager NavigationManager

<h1>Состояние обработчика</h1>

@if (reply != null)
{
    <div class="form-group">
        @((MarkupString)reply.message)
        <div class="progress">
            <div class="progress-bar" role="progressbar" style="width: 13%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                13%
            </div>
        </div>
        <label for="workerOutput" class="form-label">Вывод процесса</label>
        <textarea class="form-control" id="workerOutput" rows="10" readonly>
        </textarea>
    </div>
}

<button class="btn btn-primary" @onclick="Check">Update</button>

@code {
    class JobStatusReply
    {
        public String message { get; set; }
    }

    private JobStatusReply reply = null;

    private async Task Check()
    {
        reply = await Http.GetFromJsonAsync<JobStatusReply>(NavigationManager.ToAbsoluteUri("JobStatus"));
    }
}