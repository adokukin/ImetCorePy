@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager NavigationManager

<h1>Состояние обработчика</h1>

@if (reply != null)
{
    <div class="form-group">
        @((MarkupString)reply.message)
        <div>Обработчик: @(reply.slot)</div>
        <div class="progress">
            <div id="workerProgress" class="progress-bar" role="progressbar" style="width: @((reply.progress * 100).ToString("0"))%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                @((reply.progress * 100).ToString("0.0"))%
            </div>
        </div>
        <label for="workerOutput" class="form-label">Вывод процесса</label>
        <textarea @bind="reply.combined" class="form-control" id="workerOutput" rows="10" readonly>
        </textarea>
    </div>
}

<button class="btn btn-primary" @onclick="Check">Update</button>

@code {
    class JobStatusReply
    {
        public String message { get; set; }
        public decimal progress { get; set; }
        public int? slot { get; set; }
        public string[] output { get; set; }
        public string combined { 
            get {
                return string.Join("\r\n", output);
            }
            set {}
        }
    }

    private JobStatusReply reply = null;

    private async Task Check()
    {
        reply = await Http.GetFromJsonAsync<JobStatusReply>(NavigationManager.ToAbsoluteUri("JobStatus"));
    }
}