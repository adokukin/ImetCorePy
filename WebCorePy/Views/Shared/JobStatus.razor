@using System.Net.Http.Json
@using System.Text.Json.Nodes
@using System.IO
@using System.Timers
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime jsRuntime

@if (reply != null)
{
    @((MarkupString)reply.message)
    <div>Обработчик: @(reply.slot)</div>

    @if (reply.state == WorkerState.READY)
    {
        <h1>Результаты работы</h1>
        @if (File.Exists(reportPath))
        {
            <h4>Отчет об обучении</h4>
            <div class="alert alert-success" role="alert">Сводные результаты обучения в виде файла доступны по <a target="_blank" href="/Data@(reply.slot)/report.xlsx">ссылке</a></div>
        }
        @if (File.Exists(resultsPath))
        {
            <h4>Результат прогноза</h4>
            <div class="alert alert-success" role="alert">Результаты обработки в виде файла доступны по <a target="_blank" href="/Data@(reply.slot)/results.xlsx">ссылке</a></div>
        }

        <div class="form-group">
            <label for="workerOutput" class="form-label">Вывод процесса</label>
            <textarea @bind="log" class="form-control" id="workerOutput" rows="10" readonly></textarea>
        </div>
    }

    @if ((reply.state == WorkerState.EMPTY) || (reply.state == WorkerState.READY))
    {
        <div class="form-group">
            <div class="col-md-12">
                <div class="container">
                    <div class="row justify-content-start text-left">
                        <div class="col border py-2">
                            @if (fileTrain != null)
                            {
                                <div class="float-right font-italic">@fileTrain.filename</div>
                            }
                            <label>Загрузите файл для обучения: <InputFile OnChange="@HandleTrainFileSelection" /></label>
                            <label>Оценить качество обучения: <InputCheckbox @bind-Value="@evaluate"/></label>
                            @if (evaluate)
                            {
                                <label>Количество фолдов (0 &mdash; Leave-One-Out): <InputNumber @bind-Value="@folds" @bind-Value:after="foldsChanged" style="width: 3em;" /></label>
                            }
                        </div>
                        <div class="col border py-2">
                            @if (filePredict != null)
                            {
                                <div class="float-right font-italic">@filePredict.filename</div>
                            }
                            <label>Загрузите файл для прогнозирования (опционально): <InputFile OnChange="@HandlePredictFileSelection" /></label>  
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-12">
                <div class="row">
                    <label>Таймаут на метод, сек (0 &mdash; не установлено): <InputNumber @bind-Value="@timeout" @bind-Value:after="timeoutChanged" style="width: 3em;" /></label>
                </div>
                <div class="row">
                    <button class="btn btn-primary" @onclick="@(() => collapseAlgorithmsList = !collapseAlgorithmsList)">Выбранные методы <span class="badge badge-light">@settings.Sum(x => x.Value.selected ? 1 : 0)</span></button>
                </div>

                @if (!collapseAlgorithmsList)
                {
                    <div class="card card-body pb-0 mb-3">
                        @foreach (var algorithm in algorithms)
                        {
                            var name = algorithm["name"].ToString();
                            <div class="input-group mb-3">
                                <div class="input-group-prepend">
                                    <div class="input-group-text form-control">
                                        <InputCheckbox id="@name" @bind-Value="@settings[name].selected" class="mr-2" @bind-Value:after="algorithmToggled" />
                                        <label for="@name">@name</label>
                                    </div>
                                </div>
                                <InputText type="text" class="form-control" aria-label="@name" @bind-Value="@settings[name].settings" />
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
        <button class="btn btn-primary" @onclick="Start">Запустить</button>
    }

    @if (reply.state == WorkerState.BUSY)
    {
        <h1>Состояние обработчика</h1>
        <div class="form-group">
            <div class="progress">
                <div id="workerProgress" class="progress-bar" role="progressbar" style="width: @((reply.progress * 100).ToString("0"))%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                    @((reply.progress * 100).ToString("0.0"))%
                </div>
            </div>
            <label for="workerOutput" class="form-label">Вывод процесса</label>
            <textarea @bind="log" class="form-control" id="workerOutput" rows="10" readonly></textarea>
        </div>
        <button class="btn btn-primary" @onclick="Stop">Остановить</button>
    }
}

@code {
    class AlgorithmSettings
    {
        public bool selected { get; set; }
        public string settings { get; set; }
        public AlgorithmSettings(string settings = null)
        {
            selected = false;
            this.settings = settings;
        }
    }

    private FileUploadModel fileTrain = null;
    private FileUploadModel filePredict = null;
    private JsonArray algorithms = new JsonArray();
    private Dictionary<string, AlgorithmSettings> settings = new Dictionary<string, AlgorithmSettings>();
    private bool collapseAlgorithmsList = true;
    private int timeout;
    private int folds;
    private bool evaluate = true;

    private Timer checkTimer = null;

    public void Dispose()
    {
        if (checkTimer != null)
        {
            checkTimer.Dispose();
        }
    }

    private async Task algorithmToggled()
    {
        string selected = String.Join(",", settings.Where(kvp => kvp.Value.selected).Select(kvp => kvp.Key).ToList());
        await jsRuntime.InvokeVoidAsync("SetCookie", "algorithms", selected);
    }

    private async Task timeoutChanged()
    {
        await jsRuntime.InvokeVoidAsync("SetCookie", "timeout", timeout.ToString());
    }


    private async Task foldsChanged()
    {
        await jsRuntime.InvokeVoidAsync("SetCookie", "folds", folds.ToString());
    }

    protected override async Task OnInitializedAsync()
    {
        String json = await System.IO.File.ReadAllTextAsync("configs\\algorithms.json");
        JsonNode node = JsonNode.Parse(json);
        if (node is JsonArray)
        {
            algorithms = (JsonArray)node;
            foreach (var algorithm in algorithms)
            {
                settings[algorithm["name"].ToString()] = new AlgorithmSettings(algorithm.ToString());
            }
        }

        checkTimer = new Timer(5000);
        checkTimer.Elapsed += OnCheckTimerElapsed;
        checkTimer.AutoReset = false;
    }

    private void OnCheckTimerElapsed(object sender, ElapsedEventArgs e)
    {
        Check();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // TODO: replace invoking jsRuntime with ProtectedLocalStorage
        string cookies = await jsRuntime.InvokeAsync<string>("GetCookies");

        foreach(var cookie in cookies.Split(";"))
        {
            string[] parts = cookie.Split("=");
            if (parts.Length != 2)
            {
                continue;
            }

            string key = parts[0].Trim();
            string value = parts[1].Trim();

            switch(key)
            {
                case "slot":
                    slot = int.Parse(value);
                    break;
                case "algorithms":
                    foreach (var alg in value.Split(","))
                    {
                        if (settings.ContainsKey(alg)){
                            settings[alg].selected = true;
                        }
                    }
                    break;
                case "timeout":
                    timeout = int.Parse(value);
                    break;
                case "folds":
                    folds = int.Parse(value);
                    break;
            }
        }

        await Check();
    }

    private async void HandleTrainFileSelection(InputFileChangeEventArgs e)
    {
        fileTrain = await UploadFile(e.File);
        await InvokeAsync(StateHasChanged);
    }

    private async void HandlePredictFileSelection(InputFileChangeEventArgs e)
    {
        filePredict = await UploadFile(e.File);
        await InvokeAsync(StateHasChanged);
    }

    class JobStatusReply
    {
        public WorkerState? state { get; set; }
        public String message { get; set; }
        public decimal progress { get; set; }
        public int? slot { get; set; }
        public string[] output { get; set; }
    }

    private JobStatusReply reply = null;
    private string log = "";
    private int? slot = null;

    private async Task HandleResponse()
    {
        if (reply.state == WorkerState.BUSY)
        {
            checkTimer.Start();
        }

        string output = string.Join(Environment.NewLine, reply.output);
        log = log + (!string.IsNullOrEmpty(log) && !string.IsNullOrEmpty(output) ? Environment.NewLine : "") + output;

        // Update UI thread-safely
        await InvokeAsync(StateHasChanged);
    }

    private async Task Check()
    {
        reply = await Http.GetFromJsonAsync<JobStatusReply>(NavigationManager.ToAbsoluteUri("JobStatus") + (slot != null ? "?slot=" + slot.ToString() : ""));
        await HandleResponse();

        // TODO: deal with HTTP errors
        slot = reply.slot;
        await jsRuntime.InvokeVoidAsync("SetCookie", "slot", slot.ToString());
    }

    private async Task<FileUploadModel> UploadFile(IBrowserFile file)
    {
        FileUploadModel ret;
        if (file != null)
        {
            ret = new FileUploadModel { filename = file.Name };
            using var memoryStream = new MemoryStream();
            using var fileStream = file.OpenReadStream();
            await fileStream.CopyToAsync(memoryStream);
            ret.bytes = memoryStream.ToArray();
        }
        else
        {
            ret = new FileUploadModel { filename = null, bytes = [] };
        }
        return ret;
    }

    private async Task Start()
    {
        log = "";
        JobRequest request = new JobRequest();
        request.slot = slot;
        request.algorithms = settings.Where(kvp => kvp.Value.selected).Select(kvp => kvp.Value.settings).ToList();
        // TODO: replace with nice modal dialogues
        if (request.algorithms.Count==0)
        {
            await jsRuntime.InvokeVoidAsync("alert", "Необходимо выбрать хотя бы один алгоритм"); 
            return;
        }
        if (fileTrain == null)
        {
            await jsRuntime.InvokeVoidAsync("alert", "Необходимо загрузить обучающую выборку");
            return;
        }
        request.timeout = timeout;
        request.fileTrain = fileTrain;
        request.filePredict = filePredict;
        request.folds = evaluate ? folds : -1;

        HttpResponseMessage response = await Http.PostAsJsonAsync<JobRequest>(NavigationManager.ToAbsoluteUri("JobStart"), request);
        reply = await response.Content.ReadFromJsonAsync<JobStatusReply>();
        await HandleResponse();
    }

    private async Task Stop()
    {
        reply = await Http.GetFromJsonAsync<JobStatusReply>(NavigationManager.ToAbsoluteUri("JobStop") + "?slot=" + slot.ToString());
        await HandleResponse();
    }

    private string reportPath
    {
        get {
                return (reply != null) ? Path.Combine(Directory.GetCurrentDirectory(), $"Data{reply.slot}", "report.xlsx") : null;
            }
    }

    private string resultsPath
    {
        get
        {
            return (reply != null) ? Path.Combine(Directory.GetCurrentDirectory(), $"Data{reply.slot}", "results.xlsx") : null;
        }
    }
}