@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager NavigationManager

@if (reply != null)
{
    @((MarkupString)reply.message)
    <div>Обработчик: @(reply.slot)</div>

    @if ((reply.state == WorkerState.EMPTY) || (reply.state == WorkerState.READY))
    {
        <form method="post" enctype="multipart/form-data" asp-controller="UploadFiles" asp-action="Index">
            <div class="form-group">
                <div class="col-md-12">
                    <div class="container">
                        <div class="row justify-content-start text-left">
                            <div class="col border py-2">
                                @if (fileTrain != null)
                                {
                                    <div class="float-right font-italic">@fileTrain.Name</div>
                                }
                                <p>Загрузите файл для обучения:</p>
                                <InputFile OnChange="@HandleTrainFileSelection" />
                            </div>
                            <div class="col border py-2">
                                @if (filePredict != null)
                                {
                                    <div class="float-right font-italic">@filePredict.Name</div>
                                }
                                <p>Загрузите файл для прогнозирования (опционально):</p>
                                <InputFile OnChange="@HandlePredictFileSelection" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    }

    @if (reply.state == WorkerState.BUSY)
    {
        <h1>Состояние обработчика</h1>
        <div class="form-group">
            <div class="progress">
                <div id="workerProgress" class="progress-bar" role="progressbar" style="width: @((reply.progress * 100).ToString("0"))%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                    @((reply.progress * 100).ToString("0.0"))%
                </div>
            </div>
        </div>
    }

    @if (reply.state == WorkerState.READY)
    {
        <div class="form-group">
            <label for="workerOutput" class="form-label">Вывод процесса</label>
            <textarea @bind="reply.combined" class="form-control" id="workerOutput" rows="10" readonly></textarea>
        </div>
    }
}

<button class="btn btn-primary" @onclick="Check">Update</button>

@code {
    private IBrowserFile fileTrain = null;
    private IBrowserFile filePredict = null;

    private void HandleTrainFileSelection(InputFileChangeEventArgs e)
    {
        fileTrain = e.File;
    }

    private void HandlePredictFileSelection(InputFileChangeEventArgs e)
    {
        filePredict = e.File;
    }

    class JobStatusReply
    {
        public WorkerState? state { get; set; }
        public String message { get; set; }
        public decimal progress { get; set; }
        public int? slot { get; set; }
        public string[] output { get; set; }
        public string combined { 
            get {
                return string.Join("\r\n", output);
            }
            set {}
        }
    }

    private JobStatusReply reply = null;

    private async Task Check()
    {
        reply = await Http.GetFromJsonAsync<JobStatusReply>(NavigationManager.ToAbsoluteUri("JobStatus"));
    }
}